<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Metric Proxy</title>
    <link rel="stylesheet" type="text/css" href="styles.css">
    <script>
        (function() {
            if (localStorage.getItem('dark') === '1') {
                document.documentElement.classList.add('dark-pending');
            }
        })();
    </script>
</head>
<body>
    <script>
        if (localStorage.getItem('dark') === '1') document.body.classList.add('dark');
        function toggleDark() {
            var on = document.body.classList.toggle('dark');
            localStorage.setItem('dark', on ? '1' : '0');
            document.getElementById('dark-toggle').textContent = on ? '☀' : '🌙';
        }
    </script>
	<header>
        <img src="logo.png" alt="Logo" class="header-logo">
		<h1>Metric Proxy</h1>
        <button id="dark-toggle" onclick="toggleDark()" title="Toggle dark mode">🌙</button>
        <script>
            if (localStorage.getItem('dark') === '1')
                document.getElementById('dark-toggle').textContent = '☀';
        </script>
  </header>
    <nav>
        <ul>
            <li><a href="/index.html">Home</a></li>
            <li><a href="/jobs.html">Jobs</a></li>
            <li><a href="/alarms.html">Alarms</a></li>
            <li><a href="/topology.html">Proxy Topology</a></li>
            <li><a href="/trace.html">Trace</a></li>
            <li><a href="/profiles.html">Profiles</a></li>
            <li><a href="/model.html">Models</a></li>
            <li><a href="/ftio.html">FTIO</a></li>
            <li><a href="/doc.html">API Documentation</a></li>
        </ul>
    </nav>